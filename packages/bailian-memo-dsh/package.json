{
  "name": "bailian-memo-dsh",
  "version": "0.1.0",
  "description": "Bailian personal memory for DeepSeek Harness: automatic recall, silent curation, and user-controlled remember/forget.",
  "keywords": [
    "alibaba-cloud",
    "aliyun",
    "bailian",
    "dashscope",
    "deepseek-harness",
    "dsh",
    "memory",
    "personal-memory"
  ],
  "homepage": "https://github.com/modelstudioai/cli/tree/main/packages/bailian-memo-dsh",
  "bugs": {
    "url": "https://github.com/modelstudioai/cli/issues"
  },
  "license": "Apache-2.0",
  "author": "Aliyun Model Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelstudioai/cli.git",
    "directory": "packages/bailian-memo-dsh"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/web/client.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc -p tsconfig.web.json && tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.1",
