{
  "version": "workflow/v1",
  "inputs": {
    "type": "object",
    "properties": {
      "garmentImage": {
        "type": "string",
        "description": "Source garment image URL or local path."
      },
      "modelPrompt": {
        "type": "string",
        "description": "Prompt describing the on-model try-on scene with background.",
        "default": "一位年轻亚洲女模特身穿这件连衣裙，全身正面站立，自然微笑，长发披肩。背景为春日午后的欧式街头花园，远处有米色复古建筑、盛开的樱花树和绿色草坪，柔和阳光洒落，光影自然，杂志写真级时尚摄影，全身构图，9:16竖版，超清画质"
      },
      "videoPrompt": {
        "type": "string",
        "description": "Prompt describing the animated try-on video.",
        "default": "模特身穿连衣裙，在春日花园中自然走动并轻柔旋转，裙摆随风飘动，头发轻拂，自然微笑，柔和阳光，樱花花瓣飘落，镜头缓慢环绕拉近，时尚大片质感"
      },
      "outDir": {
        "type": "string",
        "description": "Local directory to save generated try-on image.",
        "default": "./outputs"
      },
      "videoPath": {
        "type": "string",
        "description": "Local path to save the generated try-on video.",
        "default": "./outputs/dress-tryon.mp4"
      }
    },
    "required": ["garmentImage"]
  },
  "steps": [
    {
      "id": "analyze-garment",
      "type": "vision/describe",
      "input": {
        "image": { "$input": "/garmentImage" },
        "prompt": "请详细描述这件服装：款式、颜色、材质、长度、领型、袖型、版型、风格特征，输出一段紧凑的中文段落。"
      }
    },
    {
      "id": "tryon-image",
      "type": "image/edit",
      "input": {
        "image": { "$input": "/garmentImage" },
        "prompt": {
          "$concat": [
            { "$input": "/modelPrompt" },
            "\n参考服装细节：",
            { "$from": "analyze-garment", "path": "/data/choices/0/message/content" }
          ]
        },
        "size": "9:16",
        "out-dir": { "$input": "/outDir" },
        "out-prefix": "dress-model"
      }
    },
    {
      "id": "tryon-video",
      "type": "video/generate",
      "input": {
        "prompt": {
          "$concat": [
            { "$input": "/videoPrompt" },
            "\n服装参考：",
            { "$from": "analyze-garment", "path": "/data/choices/0/message/content" }
          ]
        },
        "image": { "$from": "tryon-image", "path": "/artifacts/0/url" },
        "resolution": "1080P",
        "ratio": "9:16",
        "duration": 5,
        "download": { "$input": "/videoPath" }
      }
    }
  ]
}
