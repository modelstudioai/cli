{
  "version": "workflow/v1",
  "inputs": {
    "type": "object",
    "properties": {
      "imagePrompt": { "type": "string" },
      "videoPrompt": { "type": "string" }
    },
    "required": ["imagePrompt", "videoPrompt"],
    "additionalProperties": false
  },
  "steps": [
    {
      "id": "image",
      "type": "image/generate",
      "input": {
        "prompt": {
          "$input": "/imagePrompt"
        },
        "size": "1280*720",
        "n": 1
      }
    },
    {
      "id": "video",
      "type": "video/generate",
      "dependsOn": ["image"],
      "input": {
        "prompt": {
          "$input": "/videoPrompt"
        },
        "image": {
          "$from": "image",
          "path": "/artifacts/0/url"
        },
        "ratio": "16:9",
        "duration": 5,
        "download": "./outputs/image-to-video.mp4"
      }
    }
  ]
}
