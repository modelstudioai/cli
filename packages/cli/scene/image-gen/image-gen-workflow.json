{
  "version": "workflow/v1",
  "inputs": {
    "type": "object",
    "properties": {
      "prompt": { "type": "string" },
      "styleImage": { "type": "string" },
      "styleVisionModel": { "type": "string", "default": "qwen3.7-max" },
      "imageModel": { "type": "string", "default": "qwen-image-2.0-pro" },
      "size": { "type": "string", "default": "1920*1080" },
      "n": { "type": "number", "default": 1 },
      "promptExtend": { "type": "boolean", "default": true }
    },
    "required": ["prompt", "styleImage"],
    "additionalProperties": false
  },
  "steps": [
    {
      "id": "prepare-style-aligned-prompt",
      "type": "vision/describe",
      "input": {
        "model": {
          "$input": "/styleVisionModel"
        },
        "image": {
          "$input": "/styleImage"
        },
        "prompt": {
          "$concat": [
            "你是图像风格迁移提示词专家。用户会提供一张「风格参考图」和一段「内容描述」。请综合二者：理解参考图的色调、笔触、质感、构图倾向、氛围等视觉风格；再根据内容描述写出一段可直接用于文生图模型的提示词，使生成结果在视觉风格上与参考图一致，内容主题符合描述。输出时尽量完整保留用户输入信息，不要随意省略细节、元素、关系和约束。务必使用简体中文输出，不得输出英文句子，不要解释、不要 markdown，只输出提示词正文。\n\n【内容描述】\n",
            { "$input": "/prompt" },
            "\n\n请结合上面的风格参考图，输出文生图提示词。"
          ]
        }
      }
    },
    {
      "id": "generate-image",
      "type": "image/generate",
      "dependsOn": ["prepare-style-aligned-prompt"],
      "input": {
        "model": {
          "$input": "/imageModel"
        },
        "prompt": {
          "$from": "prepare-style-aligned-prompt",
          "path": "/data/choices/0/message/content"
        },
        "size": {
          "$input": "/size"
        },
        "n": {
          "$input": "/n"
        },
        "prompt-extend": {
          "$input": "/promptExtend"
        },
        "out-dir": "./outputs",
        "out-prefix": "image-gen"
      }
    }
  ]
}
