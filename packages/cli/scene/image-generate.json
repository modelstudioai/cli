{
  "version": "workflow/v1",
  "inputs": {
    "type": "object",
    "properties": {
      "prompt": { "type": "string" }
    },
    "required": ["prompt"],
    "additionalProperties": false
  },
  "steps": [
    {
      "id": "image",
      "type": "image/generate",
      "input": {
        "prompt": {
          "$input": "/prompt"
        },
        "size": "1024*1024",
        "n": 1,
        "out-dir": "./outputs",
        "out-prefix": "pipeline-image"
      }
    }
  ]
}
