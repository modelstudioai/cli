    "csv-parse": "catalog:",
    "csv-stringify": "catalog:",
    "tar-stream": "catalog:",
    "undici": "catalog:",
    "yaml": "^2.8.3",
    "yauzl": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "@types/node": "catalog:",
    "@types/tar-stream": "catalog:",
